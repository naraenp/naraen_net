# EditorConfig (https://editorconfig.org)
# Codifies the conventions already used across this repo so editors match them.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Markdown: trailing spaces can be meaningful (hard line breaks), so leave them.
[*.{md,markdown}]
trim_trailing_whitespace = false
